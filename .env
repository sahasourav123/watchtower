ENV=production
BLACKLIST_HOSTS=

# Self Monitoring (Deployments)
MONITOR_HASH_KEY=

# Tracking & Monitoring
GTAG=G-XXXXXXXX
NEW_RELIC_CONFIG_FILE=
NEW_RELIC_LICENSE_KEY=

# User Management
AUTH_ENABLED=false
DEFAULT_USER=guest
USER_API=

# Google OAuth
GOOGLE_CLIENT_ID=dddddddd-xdxdxdxdxdxdxdxxdxdxdxdxd.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxxxxxxxxxx
GOOGLE_AUTHORIZE_ENDPOINT=https://accounts.google.com/o/oauth2/v2/auth
GOOGLE_TOKEN_ENDPOINT=https://oauth2.googleapis.com/token
GOOGLE_REVOKE_ENDPOINT=https://oauth2.googleapis.com/revoke
GOOGLE_REDIRECT_URL=

# Github OAuth
GITHUB_CLIENT_ID=xxxxxxxxxxx
GITHUB_CLIENT_SECRET=xxxxxxxxxxxx
GITHUB_AUTHORIZE_ENDPOINT=https://github.com/login/oauth/authorize
GITHUB_TOKEN_ENDPOINT=https://github.com/login/oauth/access_token
GITHUB_REDIRECT_URL=

# Database Configuration
TIMESCALEDB_HOST=db-host
TIMESCALEDB_PORT=db-port
TIMESCALEDB_PASS=xxxxxxxxxxxx

REDIS_URL=redis://redis-host:port/0

# Notification Configuration
SLACK_CLIENT_ID=xxxxxxxxxxxx.xxxxxxxxxxxx
SLACK_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxx
SLACK_REDIRECT_URI=
SLACK_BOT_TOKEN=xoxb-xxxxxxxxxxxx-xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxx

EMAIL_BOT_URL=
EMAIL_BOT_ADDRESS=
EMAIL_BOT_TOKEN=

# Cookie Settings
COOKIE_NAME=set-cookie-name
COOKIE_SECRET=set-cookie-secret
COOKIE_EXPIRY=7
